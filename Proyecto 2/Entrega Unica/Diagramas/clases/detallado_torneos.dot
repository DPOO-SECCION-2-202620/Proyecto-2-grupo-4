digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];

label="Torneos internos (Proyecto 2, versión alineada con las HU del grupo)"; labelloc=t; fontsize=14;
"Torneo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Torneo</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ PORCENTAJE_PREFERENCIAL: double = 0.20</U><BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- tipo: TipoTorneo<BR ALIGN="LEFT"/>- cupos: int<BR ALIGN="LEFT"/>- tarifa: double<BR ALIGN="LEFT"/>- porcentajeBono: double<BR ALIGN="LEFT"/>- fechaInicio: LocalDate<BR ALIGN="LEFT"/>- fechaCierrePreferencial: LocalDate<BR ALIGN="LEFT"/>- estado: EstadoTorneo<BR ALIGN="LEFT"/>- inscripciones: List&lt;InscripcionTorneo&gt;<BR ALIGN="LEFT"/>- encuentros: List&lt;EncuentroTorneo&gt;<BR ALIGN="LEFT"/>- posiciones: List&lt;InscripcionTorneo&gt;<BR ALIGN="LEFT"/>- premios: List&lt;Premio&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validarDatos(hoy: LocalDate): void<BR ALIGN="LEFT"/>+ getCuposPreferenciales(): int<BR ALIGN="LEFT"/>+ getCuposDisponibles(tipo: TipoCupo, hoy: LocalDate): int<BR ALIGN="LEFT"/>+ preferencialesLiberados(hoy: LocalDate): boolean<BR ALIGN="LEFT"/># registrarInscripcion(ins: InscripcionTorneo, elegible: boolean, hoy: LocalDate): TipoCupo<BR ALIGN="LEFT"/>+ buscarInscripcion(u: Usuario): InscripcionTorneo<BR ALIGN="LEFT"/>+ retirar(ins: InscripcionTorneo): InscripcionTorneo<BR ALIGN="LEFT"/>+ iniciar(hoy: LocalDate): void<BR ALIGN="LEFT"/>+ registrarEncuentro(a, b: InscripcionTorneo, marcadorA: int, marcadorB: int, fase: String): EncuentroTorneo<BR ALIGN="LEFT"/>+ finalizar(posiciones: List&lt;InscripcionTorneo&gt;, porcentajePremio: double): void<BR ALIGN="LEFT"/>+ calcularBolsa(): double<BR ALIGN="LEFT"/>+ getEstadoTexto(): String<BR ALIGN="LEFT"/>+ generarHistorial(): String<BR ALIGN="LEFT"/><I># validarDatosEspecificos(): void</I><BR ALIGN="LEFT"/><I>+ getDescripcion(): String</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"TorneoIndividual" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>TorneoIndividual</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- disciplina: Disciplina<BR ALIGN="LEFT"/>- nivel: Nivel<BR ALIGN="LEFT"/>- dobles: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ inscribir(jugadores: List&lt;Usuario&gt;, ranking: double, elegible: boolean, hoy: LocalDate): InscripcionTorneoIndividual<BR ALIGN="LEFT"/># validarDatosEspecificos(): void  (pádel en dobles)<BR ALIGN="LEFT"/>+ getJugadoresPorInscripcion(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"TorneoConjunto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>TorneoConjunto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- deporte: Deporte<BR ALIGN="LEFT"/>- categoria: Categoria<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ inscribirEquipo(equipo: Equipo, ranking: double, elegible: boolean, hoy: LocalDate): InscripcionTorneoEquipo<BR ALIGN="LEFT"/>+ buscarInscripcionDeEquipo(e: Equipo): InscripcionTorneoEquipo<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"InscripcionTorneo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>InscripcionTorneo</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- tipoCupo: TipoCupo<BR ALIGN="LEFT"/>- tarifaPagada: double<BR ALIGN="LEFT"/>- ranking: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getIntegrantes(): List&lt;Usuario&gt;</I><BR ALIGN="LEFT"/><I>+ getNombre(): String</I><BR ALIGN="LEFT"/>+ incluye(u: Usuario): boolean<BR ALIGN="LEFT"/>+ esDeEmpleado(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"InscripcionTorneoIndividual" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>InscripcionTorneoIndividual</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jugadores: List&lt;Usuario&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getIntegrantes(): List&lt;Usuario&gt;<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"InscripcionTorneoEquipo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>InscripcionTorneoEquipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- equipo: Equipo<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getIntegrantes(): List&lt;Usuario&gt;<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"EncuentroTorneo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EncuentroTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- fase: String<BR ALIGN="LEFT"/>- ladoA: InscripcionTorneo<BR ALIGN="LEFT"/>- ladoB: InscripcionTorneo<BR ALIGN="LEFT"/>- marcadorA: int<BR ALIGN="LEFT"/>- marcadorB: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getGanador(): InscripcionTorneo<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"Premio" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Premio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- puesto: int<BR ALIGN="LEFT"/>- inscripcion: InscripcionTorneo<BR ALIGN="LEFT"/>- monto: double<BR ALIGN="LEFT"/>- bonos: List&lt;BonoDescuento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarBono(b: BonoDescuento): void<BR ALIGN="LEFT"/>+ getDescripcion(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"BonoDescuento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>BonoDescuento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- codigo: String<BR ALIGN="LEFT"/>- porcentaje: double<BR ALIGN="LEFT"/>- torneoOrigen: String<BR ALIGN="LEFT"/>- fechaOtorgado: LocalDate<BR ALIGN="LEFT"/>- usado: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ generarCodigo(torneo: String, idUsuario: String): String</U><BR ALIGN="LEFT"/>+ estaDisponible(): boolean<BR ALIGN="LEFT"/>+ usar(): void<BR ALIGN="LEFT"/>+ calcularDescuento(base: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo", fontsize=9];
"Usuario" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Usuario", fontsize=9];
"Equipo" [shape=box, style="dashed,filled", fillcolor="#EAF6EC", label="Equipo", fontsize=9];
"Venta" [shape=box, style="dashed,filled", fillcolor="#F7EAF5", label="Venta", fontsize=9];
subgraph cluster_enums { label="Enumeraciones nuevas"; style=dashed; fontsize=10;
"TipoTorneo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">RECREATIVO<BR ALIGN="LEFT"/>COMPETITIVO<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"EstadoTorneo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">POR_INICIAR<BR ALIGN="LEFT"/>EN_CURSO<BR ALIGN="LEFT"/>FINALIZADO<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"TipoCupo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoCupo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PREFERENCIAL<BR ALIGN="LEFT"/>REGULAR<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
}
"TorneoIndividual" -> "Torneo" [arrowhead=empty, arrowsize=1.1];
"TorneoConjunto" -> "Torneo" [arrowhead=empty, arrowsize=1.1];
"InscripcionTorneoIndividual" -> "InscripcionTorneo" [arrowhead=empty, arrowsize=1.1];
"InscripcionTorneoEquipo" -> "InscripcionTorneo" [arrowhead=empty, arrowsize=1.1];
"Torneo" -> "InscripcionTorneo" [dir=both, arrowtail=diamond, arrowhead=none, label="inscripciones", taillabel="1", headlabel="0..*"];
"Torneo" -> "EncuentroTorneo" [dir=both, arrowtail=diamond, arrowhead=none, label="encuentros", taillabel="1", headlabel="0..*"];
"Torneo" -> "Premio" [dir=both, arrowtail=diamond, arrowhead=none, label="premios", taillabel="1", headlabel="0..1"];
"Torneo" -> "InscripcionTorneo" [arrowhead=vee, arrowsize=0.7, label="posiciones", taillabel="0..1", headlabel="0..*"];
"EncuentroTorneo" -> "InscripcionTorneo" [arrowhead=vee, arrowsize=0.7, label="ladoA / ladoB", taillabel="0..*", headlabel="2"];
"Premio" -> "InscripcionTorneo" [arrowhead=vee, arrowsize=0.7, label="inscripcion", taillabel="0..1", headlabel="1"];
"Premio" -> "BonoDescuento" [arrowhead=vee, arrowsize=0.7, label="bonos", taillabel="0..1", headlabel="0..*"];
"InscripcionTorneoIndividual" -> "Usuario" [arrowhead=vee, arrowsize=0.7, label="jugadores", taillabel="0..*", headlabel="1..2"];
"InscripcionTorneoEquipo" -> "Equipo" [arrowhead=vee, arrowsize=0.7, label="equipo", taillabel="0..*", headlabel="1"];
"Usuario" -> "BonoDescuento" [dir=both, arrowtail=diamond, arrowhead=none, label="bonos", taillabel="1", headlabel="0..*"];
"Venta" -> "BonoDescuento" [arrowhead=vee, arrowsize=0.7, label="bonoAplicado", taillabel="0..*", headlabel="0..1"];
"ClubDeportivo" -> "Torneo" [dir=both, arrowtail=diamond, arrowhead=none, label="torneos", taillabel="1", headlabel="0..*"];
}
