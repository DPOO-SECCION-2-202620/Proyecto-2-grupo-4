digraph G {
rankdir=LR;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];
label="Proyecto 2: métodos nuevos de la fachada y la persistencia"; labelloc=t; fontsize=14;

"ClubDeportivo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ClubDeportivo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(colecciones del Proyecto 1)<BR ALIGN="LEFT"/>- torneos: List&lt;Torneo&gt;<BR ALIGN="LEFT"/>- porcentajePremioCompetitivo: double = 0.70<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buscarUsuarioPorLogin(login: String): Usuario<BR ALIGN="LEFT"/>+ registrarExterno(nombre, documento, login, password, esEstudiante, niveles): ParticipanteExterno<BR ALIGN="LEFT"/>+ crearTorneoIndividual(admin, nombre, tipo, disciplina, nivel, dobles, cupos, tarifa, porcentajeBono, inicio, limite, hoy): TorneoIndividual<BR ALIGN="LEFT"/>+ crearTorneoConjunto(admin, nombre, tipo, deporte, categoria, cupos, tarifa, porcentajeBono, inicio, limite, hoy): TorneoConjunto<BR ALIGN="LEFT"/>+ registrarTorneo(t: Torneo, hoy: LocalDate): void<BR ALIGN="LEFT"/>+ buscarTorneo(nombre: String): Torneo<BR ALIGN="LEFT"/>+ consultarTorneos(estado: EstadoTorneo): List&lt;Torneo&gt;<BR ALIGN="LEFT"/>+ resumenTorneos(estado: EstadoTorneo): String<BR ALIGN="LEFT"/>+ consultarHistorialTorneo(nombre: String): String<BR ALIGN="LEFT"/>+ consultarTorneosDe(u: Usuario): List&lt;Torneo&gt;<BR ALIGN="LEFT"/>+ obtenerNivel(u: Usuario, d: Disciplina): Nivel<BR ALIGN="LEFT"/>+ calcularRankingIndividual(u: Usuario, d: Disciplina): double<BR ALIGN="LEFT"/>+ calcularPuntosInternos(e: Equipo): double<BR ALIGN="LEFT"/>+ rankingsDeCategoria(t: TorneoIndividual | TorneoConjunto): List&lt;Double&gt;<BR ALIGN="LEFT"/>+ esElegiblePreferencial(ranking: double, rankings: List&lt;Double&gt;, n: int): boolean<BR ALIGN="LEFT"/>+ inscribirEnTorneoIndividual(u: Usuario, torneo: String, loginPareja: String, hoy): InscripcionTorneoIndividual<BR ALIGN="LEFT"/>+ puedeGestionarEquipo(u: Usuario, e: Equipo): boolean<BR ALIGN="LEFT"/>+ inscribirEquipoEnTorneo(u: Usuario, torneo: String, equipo: String, hoy): InscripcionTorneoEquipo<BR ALIGN="LEFT"/>+ salirDeTorneo(u: Usuario, torneo: String): InscripcionTorneo<BR ALIGN="LEFT"/>+ retirarEquipoDeTorneo(u: Usuario, torneo: String, equipo: String): InscripcionTorneo<BR ALIGN="LEFT"/>+ iniciarTorneo(admin, torneo: String, hoy): void<BR ALIGN="LEFT"/>+ registrarEncuentroTorneo(admin, torneo, idA: int, idB: int, a: int, b: int, fase: String): EncuentroTorneo<BR ALIGN="LEFT"/>+ finalizarTorneo(admin, torneo: String, idsEnOrden: List&lt;Integer&gt;): void<BR ALIGN="LEFT"/>+ aplicarBono(v: Venta, codigo: String): void<BR ALIGN="LEFT"/>+ verificarMinimoHabilitados(e: Entrenador, equipo: String): String  (HU-ENT-02)<BR ALIGN="LEFT"/>+ getEquiposDe(e: Entrenador): List&lt;Equipo&gt;<BR ALIGN="LEFT"/>+ asignarEntrenador(admin, equipo: String, e: Entrenador): void<BR ALIGN="LEFT"/>+ getSolicitudesPendientes(): List&lt;SolicitudCambioTurno&gt;<BR ALIGN="LEFT"/>+ rechazarCambioTurno(admin, id: int): void<BR ALIGN="LEFT"/><I>Consultas y acciones que usan las consolas:</I><BR ALIGN="LEFT"/>+ getEquiposDeSocio(s: Socio): List&lt;Equipo&gt;<BR ALIGN="LEFT"/>+ getEntrenadores(): List&lt;Entrenador&gt;<BR ALIGN="LEFT"/>+ getReservasDe(s: Socio): List&lt;Reserva&gt;<BR ALIGN="LEFT"/>+ getSolicitudesDe(e: Empleado): List&lt;SolicitudCambioTurno&gt;<BR ALIGN="LEFT"/>+ declararNivel(u: Usuario, d: Disciplina, n: Nivel): void<BR ALIGN="LEFT"/>+ reservar(u, instalacion, fechaHora, cantidad, modalidad, hoy: LocalDate): Reserva  (rechaza fechas pasadas)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EEEEEE"];
"PersistenciaClub" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>PersistenciaClub</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ EXTENSION_TEMPORAL: String = ".temporal"</U><BR ALIGN="LEFT"/>- temporales: List&lt;File&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(club, rutaCarpeta: String): void<BR ALIGN="LEFT"/>+ cargar(rutaCarpeta: String): ClubDeportivo<BR ALIGN="LEFT"/>- escribirTemporales(club, carpeta): void<BR ALIGN="LEFT"/>- reemplazarDefinitivos(): void<BR ALIGN="LEFT"/>- borrarTemporales(): void<BR ALIGN="LEFT"/>(torneos.txt, inscripciones_torneo.txt, encuentros_torneo.txt, premios_torneo.txt,<BR ALIGN="LEFT"/>   bonos.txt, niveles_declarados.txt, usuarios EXTERNO, PREMIO en config.txt,<BR ALIGN="LEFT"/>   entrenador en equipos.txt, bono en ventas.txt)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EEEEEE"];
"Torneo" [shape=box, style="dashed,filled", fillcolor="#E6F4F6", label="Torneo", fontsize=9];
"ClubDeportivo" -> "Torneo" [dir=both, arrowtail=diamond, arrowhead=none, label="torneos", taillabel="1", headlabel="0..*"];
"ClubDeportivo" -> "PersistenciaClub" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="guardar / cargar"];
}
