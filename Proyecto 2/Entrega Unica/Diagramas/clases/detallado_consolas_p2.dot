digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];
label="Proyecto 2: consolas (una aplicación por tipo de usuario) y persistencia automática"; labelloc=t; fontsize=14;
"ConsolaBase" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>ConsolaBase</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ INTENTOS_PERMITIDOS: int = 3</U><BR ALIGN="LEFT"/><U># TORNEO_CONSULTAR ... TORNEO_RETIRAR_EQUIPO: String</U><BR ALIGN="LEFT"/># lector: LectorEntrada<BR ALIGN="LEFT"/># club: ClubDeportivo<BR ALIGN="LEFT"/># usuario: Usuario<BR ALIGN="LEFT"/># torneos: FlujosTorneo<BR ALIGN="LEFT"/>- datos: GestorDatos<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ejecutar(): void {final}<BR ALIGN="LEFT"/>- iniciarSesion(): Usuario<BR ALIGN="LEFT"/># ejecutarMenu(menu: Menu): void<BR ALIGN="LEFT"/>- atenderOpcionDeTorneos(codigo: String): boolean<BR ALIGN="LEFT"/><I># getNombreAplicacion(): String</I><BR ALIGN="LEFT"/><I># aceptaUsuario(u: Usuario): boolean</I><BR ALIGN="LEFT"/><I># getMensajeOtroRol(): String</I><BR ALIGN="LEFT"/><I># crearMenuPrincipal(): Menu</I><BR ALIGN="LEFT"/><I># atenderOpcion(codigo: String): void</I><BR ALIGN="LEFT"/># antesDeIniciarSesion(): void<BR ALIGN="LEFT"/># equiposQueGestiono(): List&lt;Equipo&gt;<BR ALIGN="LEFT"/># hoy(): LocalDate<BR ALIGN="LEFT"/><U>+ mostrarTitulo / mostrarLista / mostrarTexto</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"ConsolaAdministrador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ConsolaAdministrador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/>- crearMenuTorneos() ... crearMenuReportes(): Menu<BR ALIGN="LEFT"/>- crearTorneo(esIndividual: boolean): void<BR ALIGN="LEFT"/>- iniciarTorneo(): void<BR ALIGN="LEFT"/>- registrarEncuentro(): void<BR ALIGN="LEFT"/>- finalizarTorneo(): void<BR ALIGN="LEFT"/>(turnos, sugerencias, inventario,<BR ALIGN="LEFT"/> equipos, reportes, usuarios)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"ConsolaParticipante" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ConsolaParticipante</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/># antesDeIniciarSesion(): void  (registro)<BR ALIGN="LEFT"/># equiposQueGestiono(): List&lt;Equipo&gt;<BR ALIGN="LEFT"/>- registrarse(): void<BR ALIGN="LEFT"/>- comprarEnTienda() / comprarEnCafeteria(): void<BR ALIGN="LEFT"/>- terminarCompra(v: Venta): void  (bono)<BR ALIGN="LEFT"/>- reservar(): void<BR ALIGN="LEFT"/>- inscribirmeEnEquipo(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"ConsolaEntrenador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ConsolaEntrenador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args: String[]): void</U><BR ALIGN="LEFT"/># equiposQueGestiono(): List&lt;Equipo&gt;<BR ALIGN="LEFT"/>- declararNivel(): void<BR ALIGN="LEFT"/>- pedirCambioTurno(): void<BR ALIGN="LEFT"/>- sugerirProducto(): void<BR ALIGN="LEFT"/>- verificarMinimo(): void<BR ALIGN="LEFT"/>- verMisEquipos(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"FlujosTorneo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>FlujosTorneo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- club: ClubDeportivo<BR ALIGN="LEFT"/>- lector: LectorEntrada<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ consultarTorneos(): void<BR ALIGN="LEFT"/>+ verHistorial(): void<BR ALIGN="LEFT"/>+ verMisTorneos(u: Usuario): void<BR ALIGN="LEFT"/>+ elegirTorneo(estado: EstadoTorneo): Torneo<BR ALIGN="LEFT"/>+ inscribirmeEnIndividual(u: Usuario, hoy: LocalDate): void<BR ALIGN="LEFT"/>+ salirmeDeIndividual(u: Usuario, hoy: LocalDate): void<BR ALIGN="LEFT"/>+ inscribirEquipo(u, equipos: List, hoy): void<BR ALIGN="LEFT"/>+ retirarEquipo(u, equipos: List, hoy): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"Menu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Menu</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ SALIR: String = "SALIR"</U><BR ALIGN="LEFT"/>- titulo: String<BR ALIGN="LEFT"/>- textoSalir: String<BR ALIGN="LEFT"/>- codigos: List&lt;String&gt;<BR ALIGN="LEFT"/>- textos: List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarOpcion(codigo: String, texto: String): void<BR ALIGN="LEFT"/>+ pedirOpcion(lector: LectorEntrada): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"LectorEntrada" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>LectorEntrada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ LONGITUD_MAXIMA: int = 80</U><BR ALIGN="LEFT"/>- teclado: Scanner<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ leerTexto / leerTextoOpcional(pregunta): String<BR ALIGN="LEFT"/>+ leerNombreUsuario / leerClave(pregunta): String<BR ALIGN="LEFT"/>+ leerEntero(pregunta, minimo, maximo): int<BR ALIGN="LEFT"/>+ leerDecimal(pregunta, minimo, maximo): double<BR ALIGN="LEFT"/>+ leerFecha(pregunta [, minima, maxima]): LocalDate<BR ALIGN="LEFT"/>+ leerFechaHora(pregunta): LocalDateTime<BR ALIGN="LEFT"/>+ leerHora(pregunta, minima, maxima): LocalTime<BR ALIGN="LEFT"/>+ leerSiNo(pregunta) / confirmar(accion): boolean<BR ALIGN="LEFT"/>+ elegir(titulo, opciones: List&lt;T&gt;): T<BR ALIGN="LEFT"/>+ elegirObligatorio(titulo, opciones: T[]): T<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"EntradaTerminadaException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EntradaTerminadaException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"GestorDatos" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>GestorDatos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ CARPETA_POR_DEFECTO: String = "datos"</U><BR ALIGN="LEFT"/>- carpeta: File<BR ALIGN="LEFT"/>- club: ClubDeportivo<BR ALIGN="LEFT"/>- yaSeGuardo: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cargar(): ClubDeportivo<BR ALIGN="LEFT"/>+ guardar(): boolean<BR ALIGN="LEFT"/>+ getRuta(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"GeneradorDatosPrueba" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>GeneradorDatosPrueba</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ FECHA_REF: LocalDate</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args): void</U><BR ALIGN="LEFT"/><U>+ crearClub(): ClubDeportivo</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFFFFF"];
"PersistenciaClub" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>PersistenciaClub</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ EXTENSION_TEMPORAL: String = ".temporal"</U><BR ALIGN="LEFT"/>- temporales: List&lt;File&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(club, rutaCarpeta): void<BR ALIGN="LEFT"/>+ cargar(rutaCarpeta): ClubDeportivo<BR ALIGN="LEFT"/>- escribirTemporales(club, carpeta): void<BR ALIGN="LEFT"/>- reemplazarDefinitivos(): void<BR ALIGN="LEFT"/>- borrarTemporales(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F3F6FA"];
"EscritorClub" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>EscritorClub</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- club: ClubDeportivo<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ lineasConfiguracion(): List&lt;String&gt;<BR ALIGN="LEFT"/>+ lineasUsuarios(): List&lt;String&gt;<BR ALIGN="LEFT"/>+ lineasTorneos(): List&lt;String&gt;<BR ALIGN="LEFT"/>... (un método por archivo, 33 en total)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F3F6FA"];
"LectorClub" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>LectorClub</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- carpeta: File<BR ALIGN="LEFT"/>- club: ClubDeportivo<BR ALIGN="LEFT"/>- archivoActual: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cargarTodo(): ClubDeportivo<BR ALIGN="LEFT"/>+ getArchivoActual(): String<BR ALIGN="LEFT"/>- cargarUsuarios(): void<BR ALIGN="LEFT"/>- cargarTorneos(): void<BR ALIGN="LEFT"/>... (un método por archivo, en orden de dependencias)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F3F6FA"];
"ArchivoTexto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ArchivoTexto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ SEPARADOR = ";"  SEPARADOR_LISTA = "|"  VACIO = "-"</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ escribir(archivo, formato, lineas): void</U><BR ALIGN="LEFT"/><U>+ leer(archivo): List&lt;String[]&gt;</U><BR ALIGN="LEFT"/><U>+ limpiar(texto): String</U><BR ALIGN="LEFT"/><U>+ unirLista(lista) / separarLista(campo)</U><BR ALIGN="LEFT"/><U>+ marcarVacio(texto) / quitarMarcaVacio(texto)</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F3F6FA"];
"ClubDeportivo" [shape=box, style="dashed,filled", fillcolor="#EEEEEE", label="ClubDeportivo\n(fachada)", fontsize=9];
"RuntimeException" [shape=box, style="dashed", label="RuntimeException", fontsize=9];
"ConsolaAdministrador" -> "ConsolaBase" [arrowhead=empty, arrowsize=1.1];
"ConsolaParticipante" -> "ConsolaBase" [arrowhead=empty, arrowsize=1.1];
"ConsolaEntrenador" -> "ConsolaBase" [arrowhead=empty, arrowsize=1.1];
"EntradaTerminadaException" -> "RuntimeException" [arrowhead=empty, arrowsize=1.1];
"ConsolaBase" -> "ClubDeportivo" [arrowhead=vee, arrowsize=0.7, label="club", headlabel="1"];
"ConsolaBase" -> "LectorEntrada" [arrowhead=vee, arrowsize=0.7, label="lector", headlabel="1"];
"ConsolaBase" -> "GestorDatos" [arrowhead=vee, arrowsize=0.7, label="datos", headlabel="1"];
"ConsolaBase" -> "FlujosTorneo" [arrowhead=vee, arrowsize=0.7, label="torneos", headlabel="1"];
"ConsolaBase" -> "Menu" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa"];
"FlujosTorneo" -> "ClubDeportivo" [arrowhead=vee, arrowsize=0.7, label="club"];
"FlujosTorneo" -> "LectorEntrada" [arrowhead=vee, arrowsize=0.7, label="lector"];
"Menu" -> "LectorEntrada" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="lee la opción"];
"LectorEntrada" -> "EntradaTerminadaException" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="lanza"];
"GestorDatos" -> "ClubDeportivo" [arrowhead=vee, arrowsize=0.7, label="club", headlabel="0..1"];
"GestorDatos" -> "GeneradorDatosPrueba" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="si no existe la carpeta"];
"ClubDeportivo" -> "PersistenciaClub" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="guardar / cargar"];
"PersistenciaClub" -> "EscritorClub" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="crea"];
"PersistenciaClub" -> "LectorClub" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="crea"];
"PersistenciaClub" -> "ArchivoTexto" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa"];
"LectorClub" -> "ArchivoTexto" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa"];
"EscritorClub" -> "ArchivoTexto" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa"];
