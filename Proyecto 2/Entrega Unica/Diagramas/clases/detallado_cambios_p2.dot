digraph G {
rankdir=BT;
graph [fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.55, pad=0.2, newrank=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [fontname="Helvetica", fontsize=8.5, labelfontsize=8.5, labeldistance=1.6, labelangle=25, color="#333333"];
label="Proyecto 2: cambios en clases existentes"; labelloc=t; fontsize=14;

"Usuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Usuario</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(atributos del Proyecto 1)<BR ALIGN="LEFT"/>- bonos: List&lt;BonoDescuento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarBono(b: BonoDescuento): void<BR ALIGN="LEFT"/>+ getBonos(): List&lt;BonoDescuento&gt;<BR ALIGN="LEFT"/>+ getBonosDisponibles(): List&lt;BonoDescuento&gt;<BR ALIGN="LEFT"/>+ buscarBono(codigo: String): BonoDescuento<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"ParticipanteExterno" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>ParticipanteExterno</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- documento: String<BR ALIGN="LEFT"/>- esEstudiante: boolean<BR ALIGN="LEFT"/>- nivelesDeclarados: Map&lt;Disciplina, Nivel&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ acumularPuntos(valor: double): void  (no acumula, D14)<BR ALIGN="LEFT"/>+ puedeUsarInstalacionesYPartidos(): boolean  (false)<BR ALIGN="LEFT"/>+ declararNivel(d: Disciplina, n: Nivel): void<BR ALIGN="LEFT"/>+ getNivelDeclarado(d: Disciplina): Nivel<BR ALIGN="LEFT"/>+ getPerfil(): String<BR ALIGN="LEFT"/>+ getTipo(): String  ("EXTERNO")<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E6F4F6"];
"Empleado" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Empleado</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(turnos del Proyecto 1)<BR ALIGN="LEFT"/>- nivelesDeclarados: Map&lt;Disciplina, Nivel&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tieneTurnoEl(fecha: LocalDate): boolean<BR ALIGN="LEFT"/>+ declararNivel(d: Disciplina, n: Nivel): void<BR ALIGN="LEFT"/>+ getNivelDeclarado(d: Disciplina): Nivel<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Turno" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Turno</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(sin cambios)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ nombreDia(fecha: LocalDate): String</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#E8F0FB"];
"Socio" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Socio", fontsize=9];
"Entrenador" [shape=box, style="dashed,filled", fillcolor="#E8F0FB", label="Entrenador", fontsize=9];
"Equipo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>Equipo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(atributos del Proyecto 1)<BR ALIGN="LEFT"/>- entrenador: Entrenador<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getEntrenador(): Entrenador<BR ALIGN="LEFT"/>+ setEntrenador(e: Entrenador): void<BR ALIGN="LEFT"/>+ getJugadoresNoDisponibles(): Map&lt;Socio, String&gt;  (HU-ENT-02)<BR ALIGN="LEFT"/><I>+ inscribirJugador(...)  (mensaje: "Elija un dorsal libre")</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#EAF6EC"];
"Venta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Venta</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(atributos del Proyecto 1)<BR ALIGN="LEFT"/>- bonoAplicado: BonoDescuento<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ aplicarBono(b: BonoDescuento): void<BR ALIGN="LEFT"/># calcularDescuentoBono(): double<BR ALIGN="LEFT"/># admiteBono(): boolean<BR ALIGN="LEFT"/><I>+ calcularTotal(): double  (resta también el bono)</I><BR ALIGN="LEFT"/><I>+ usarPuntosFidelidad(): void  (no acumulable con bono)</I><BR ALIGN="LEFT"/><I>+ cerrar(): void  (marca el bono como usado)</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"VentaTienda" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>VentaTienda</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(sin cambios)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># admiteBono(): boolean  (false si hay código)<BR ALIGN="LEFT"/><I>+ aplicarDescuento(c): void  (no acumulable con bono)</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"VentaMensualidad" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>VentaMensualidad</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(sin cambios)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># admiteBono(): boolean  (siempre false)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#F7EAF5"];
"VentaCafeteria" [shape=box, style="dashed,filled", fillcolor="#F7EAF5", label="VentaCafeteria", fontsize=9];
"Instalacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I><B>Instalacion</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(sin cambios)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ motivoRechazo(cantidad: int, modalidad: String): String  (a implementar)<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"CanchaPadel" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BALIGN="CENTER"><B>CanchaPadel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(sin cambios)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ motivoRechazo(...): String  ("siempre en dobles")<BR ALIGN="LEFT"/></TD></TR></TABLE>>, style=filled, fillcolor="#FFF4E0"];
"BonoDescuento" [shape=box, style="dashed,filled", fillcolor="#E6F4F6", label="BonoDescuento", fontsize=9];
"leyenda" [shape=note, style=filled, fillcolor="#FFFDE7", fontsize=9, label="Solo se muestran los miembros NUEVOS o MODIFICADOS en el Proyecto 2.\nLos métodos en cursiva cambian su comportamiento.\nEn verde azulado: clases nuevas."];
"ParticipanteExterno" -> "Usuario" [arrowhead=empty, arrowsize=1.1];
"Socio" -> "Usuario" [arrowhead=empty, arrowsize=1.1];
"Empleado" -> "Usuario" [arrowhead=empty, arrowsize=1.1];
"Entrenador" -> "Empleado" [arrowhead=empty, arrowsize=1.1];
"VentaTienda" -> "Venta" [arrowhead=empty, arrowsize=1.1];
"VentaMensualidad" -> "Venta" [arrowhead=empty, arrowsize=1.1];
"VentaCafeteria" -> "Venta" [arrowhead=empty, arrowsize=1.1];
"CanchaPadel" -> "Instalacion" [arrowhead=empty, arrowsize=1.1];
"Usuario" -> "BonoDescuento" [dir=both, arrowtail=diamond, arrowhead=none, label="bonos", taillabel="1", headlabel="0..*"];
"Venta" -> "BonoDescuento" [arrowhead=vee, arrowsize=0.7, label="bonoAplicado", taillabel="0..*", headlabel="0..1"];
"Equipo" -> "Entrenador" [arrowhead=vee, arrowsize=0.7, label="entrenador", taillabel="0..*", headlabel="0..1"];
"Venta" -> "Usuario" [arrowhead=vee, arrowsize=0.7, label="comprador", taillabel="0..*", headlabel="1"];
"Empleado" -> "Turno" [style=dashed, arrowhead=vee, arrowsize=0.7, color="#555555", label="usa nombreDia"];
}
